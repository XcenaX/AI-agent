PROVIDER=zai
OPENAI_MODEL=gpt-5
ANTHROPIC_MODEL=claude-sonnet-4

ZAI_API_KEY=key
ZAI_BASE_URL=https://api.z.ai/api/anthropic/v1
ZAI_MODEL=glm-4.7-flash

COMETAPI_KEY=key
COMETAPI_BASE_URL=https://api.cometapi.com/v1
COMETAPI_MODEL=claude-sonnet-4-5-20250929

WEBPILOT_CHANNEL=chrome
WEBPILOT_HEADLESS=0
WEBPILOT_USER_DATA_DIR=./profile
WEBPILOT_SLOW_MO_MS=80

# Playwright profile folder (persistent session)
USER_DATA_DIR=./profile

# optional
MAX_STEPS=80
WEBPILOT_LOG_LEVEL=INFO
LLM_TIMEOUT_S=120

OPENAI_API_KEY=key
ANTHROPIC_API_KEY=key

OBS_ELEM_NAME_CHARS=45
OBS_INCLUDE_TEXT=1
OBS_MAX_TEXT_CHARS_OBSERVER=1000

OBS_MAX_ELEMS=12
OBS_MAX_ELEMS_OBSERVER=28

OPENAI_MAX_HISTORY_STEPS=6
MAX_HISTORY=8

MEMORY_PROMPT_CHARS=350

DONE_MAX_ITEMS=3
FACTS_MAX_ITEMS=2
FACT_MAX_CHARS=80
FACTS_IN_PROMPT=1

AUTO_EXTRACT=0

LLM_TRACE=1
LLM_TRACE_PATH=logs/llm_trace_{run_id}.jsonl
LLM_TRACE_FULL=0
LLM_TRACE_MAX_MSG_CHARS=12000
LLM_TRACE_ELEMS_SAMPLE=40
LLM_TRACE_TEXT_PREVIEW=500
LLM_TRACE_REDACT_PII=0